{
  "name": "dsh-kinich-theme",
  "version": "2.0.3-rc.1",
  "description": "Modern Jungle Kinich & Ajaw UI for DeepSeek Harness Web and Desktop with live official DeepSeek balance monitoring and a CNY low-balance alert state.",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "assets/wallpapers/camille-reference",
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "LICENSE",
    "THIRD_PARTY_ASSETS.md",
    "RELEASE_NOTES.md",
    "docs/DESIGN_AND_MOTION.md"
  ],
  "dsh": {
    "manifestVersion": 1,
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-api-remotes"
      ],
      "platform": "web",
      "immediately": true
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.0-rc.2 <0.3.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-settings": ">=0.2.0-rc.2 <0.3.0",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-settings": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/check.mjs",
    "verify": "npm run test:version && npm run test:wallpaper && npm run build && npm run check && npm run test:stage4 && npm run test:balance-client && npm run test:settings && npm run test:background && npm run test:interaction && npm run test:presentation && npm run test:compat && npm run test:dsh017",
    "test:version": "node scripts/test-version-policy.mjs",
    "test:wallpaper": "node scripts/test-wallpaper.mjs",
    "test:stage4": "node scripts/test-stage4.mjs",
    "test:balance-client": "node scripts/test-balance-client.mjs",
    "test:settings": "node scripts/test-settings-write.mjs",
    "test:background": "node scripts/test-background.mjs",
    "test:interaction": "node scripts/test-interaction.mjs",
    "test:presentation": "node scripts/test-presentation.mjs",
    "test:compat": "node scripts/test-dsh-016.mjs",
    "test:dsh017": "node scripts/test-dsh-017.mjs",
    "setup": "npm install --omit=dev",
    "test:wallpaper-renderer": "node scripts/test-wallpaper-renderer.mjs",
    "test:wallpaper-boundaries": "node scripts/test-wallpaper-boundaries.mjs",
    "test:wallpaper-switch": "node scripts/test-wallpaper-switch.mjs",
    "test:wallpaper-consistency": "node scripts/test-wallpaper-consistency.mjs",
    "test:release-201-ui": "node scripts/test-release-201-ui.mjs"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "theme",
    "kinich",
    "ajaw",
    "natlan",
    "web"
  ],
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.4",
    "fflate": "0.8.3"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  },
  "author": "Xian-JL (LiqWhisper)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Xian-JL/dsh-Kinich-theme.git"
  },
  "bugs": {
    "url": "https://github.com/Xian-JL/dsh-Kinich-theme/issues"
  },
  "homepage": "https://github.com/Xian-JL/dsh-Kinich-theme#readme",
  "publishConfig": {
    "access": "public"
  },
  "kinich": {
    "wallpaperReleaseStage": "candidate",
    "wallpaperSpecVersion": "1.0.7"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
