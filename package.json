{
  "name": "dsh-kinich-theme",
  "version": "1.0.0",
  "description": "Interactive Kinich & Ajaw theme for DeepSeek Harness Web with live visual modes, session feedback, themed sidebar, visual intensity, and dynamic ambient effects.",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "LICENSE",
    "THIRD_PARTY_ASSETS.md",
    "RELEASE_NOTES.md"
  ],
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-api-remotes"
      ],
      "platform": "web",
      "immediately": true
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-settings": "0.1.5-rc.1",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-settings": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/check.mjs",
    "verify": "npm run build && npm run check",
    "setup": "npm install --omit=dev"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "theme",
    "kinich",
    "ajaw",
    "natlan",
    "web"
  ],
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.1"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  },
  "author": "Xian-JL (LiqWhisper)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Xian-JL/dsh-Kinich-theme.git"
  },
  "bugs": {
    "url": "https://github.com/Xian-JL/dsh-Kinich-theme/issues"
  },
  "homepage": "https://github.com/Xian-JL/dsh-Kinich-theme#readme",
  "publishConfig": {
    "access": "public"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
